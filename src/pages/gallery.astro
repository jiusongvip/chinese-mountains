---
import BaseLayout from "../layouts/BaseLayout.astro";
import { mountains } from "../data/mountains";
---
<BaseLayout title="Photo Gallery" description="Browse stunning photography of China's most beautiful mountain landscapes.">
<section class="pt-12 pb-20">
<div class="max-w-[1400px] mx-auto px-6">
<h1 class="text-4xl font-bold tracking-tighter text-slate-900">Photo Gallery</h1>
<p class="mt-3 text-slate-500">A visual journey through China's most breathtaking mountain landscapes.</p>
<div class="columns-1 sm:columns-2 lg:columns-3 gap-4 mt-10 space-y-4">
{mountains.map((m) => (
<a href={"/mountains/"+m.slug} class="block break-inside-avoid rounded-xl overflow-hidden bg-white border border-slate-200 hover:border-accent hover:shadow-md transition-all no-underline group">
<img src={m.images[0]?.src ?? "/images/placeholder.jpg"} alt={m.images[0]?.alt ?? m.name.en} loading="lazy" class="w-full object-cover group-hover:scale-105 transition-transform duration-500" />
<div class="p-3">
<h3 class="font-medium text-sm text-slate-900">{m.name.en}</h3>
<p class="text-xs text-slate-400 mt-0.5">{m.location.province} · {m.physical.elevation.toLocaleString()}m</p>
</div>
</a>
))}
</div>
</div>
</section>
</BaseLayout>