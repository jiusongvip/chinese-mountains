---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allGuides } from "../data/guides";
import { mountains } from "../data/mountains";
import { thumb } from "../utils/thumb";
---

<BaseLayout title="China Mountain Travel Guides" description="Plan your Chinese mountain adventure with seasonal and difficulty-based guides: spring blooms, summer escapes, autumn gold, winter ice, and family peaks.">
<section class="pt-12 pb-20">
<div class="max-w-[1400px] mx-auto px-6">
<h1 class="text-4xl font-bold tracking-tighter text-slate-900">Travel Guides</h1>
<p class="mt-3 text-slate-500 max-w-[45ch]">Plan your journey with guides organized by season, experience level, and travel style.</p>
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12">Seasonal Guides</h2>
<p class="mt-2 text-sm text-slate-500">The best mountains for each season, with packing tips and what to expect.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
{allGuides.filter((g) => g.months.length > 0).map((g) => {
  let count = 0;
  if (g.months.length === 0 && g.difficulty.length === 0) {
    count = mountains.length;
  } else {
    count = mountains.filter((m) => {
      const seasonMatch = g.months.length === 0 || m.tourism.bestSeason.some((s) => g.months.includes(s));
      const diffMatch = g.difficulty.length === 0 || g.difficulty.includes(m.tourism.difficulty);
      const excludeMatch = !(g.excludeIds || []).includes(m.id);
      return seasonMatch && diffMatch && excludeMatch;
    }).length;
  }
  return (
    <a href={`/guides/${g.slug}/`} class="group rounded-xl overflow-hidden bg-white border border-slate-200 hover:border-accent hover:shadow-md transition-all no-underline">
      <div class="aspect-[16/10] overflow-hidden bg-slate-100">
        <img src={thumb(g.image, 640)} alt={g.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
      </div>
      <div class="p-5">
        <h3 class="font-semibold text-slate-900 text-base">{g.title}</h3>
        <p class="text-sm text-slate-500 mt-1.5 line-clamp-2">{g.description}</p>
        <p class="text-xs text-accent mt-3 font-medium">{count} mountains</p>
      </div>
    </a>
  );
})}
</div>
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-14">By Experience Level</h2>
<p class="mt-2 text-sm text-slate-500">Guides matched to who you're traveling with — solo first-timers or the whole family.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
{allGuides.filter((g) => g.months.length === 0).map((g) => {
  let count = 0;
  if (g.months.length === 0 && g.difficulty.length === 0) {
    count = mountains.length;
  } else {
    count = mountains.filter((m) => {
      const seasonMatch = g.months.length === 0 || m.tourism.bestSeason.some((s) => g.months.includes(s));
      const diffMatch = g.difficulty.length === 0 || g.difficulty.includes(m.tourism.difficulty);
      const excludeMatch = !(g.excludeIds || []).includes(m.id);
      return seasonMatch && diffMatch && excludeMatch;
    }).length;
  }
  return (
    <a href={`/guides/${g.slug}/`} class="group rounded-xl overflow-hidden bg-white border border-slate-200 hover:border-accent hover:shadow-md transition-all no-underline">
      <div class="aspect-[16/10] overflow-hidden bg-slate-100">
        <img src={thumb(g.image, 640)} alt={g.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
      </div>
      <div class="p-5">
        <h3 class="font-semibold text-slate-900 text-base">{g.title}</h3>
        <p class="text-sm text-slate-500 mt-1.5 line-clamp-2">{g.description}</p>
        <p class="text-xs text-accent mt-3 font-medium">{count} mountains</p>
      </div>
    </a>
  );
})}
</div>
</div>
</section>
</BaseLayout>
