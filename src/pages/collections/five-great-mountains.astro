---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MountainCard from "../../components/MountainCard.astro";
import { mountains } from "../../data/mountains";
import { thumb } from "../../utils/thumb";

const fiveGreatSlugs = ["taishan", "huashan", "hengshan-hunan", "hengshan-shanxi", "songshan"];
const fiveGreat = fiveGreatSlugs.map(s => mountains.find(m => m.slug === s)!).filter(Boolean);

const DIRECTIONS: Record<string, string> = {
  taishan: "East", huashan: "West", "hengshan-hunan": "South", "hengshan-shanxi": "North", songshan: "Center",
};
const BEST_FOR: Record<string, string> = {
  taishan: "History, Sunrise, Culture",
  huashan: "Adventure, Cliffs, Plank Walk",
  "hengshan-hunan": "Temples, Serenity, Accessibility",
  "hengshan-shanxi": "Hanging Temple, Architecture",
  songshan: "Shaolin Temple, Kung Fu, Zen",
};
const DIFF_BADGE: Record<string, string> = {
  easy: "bg-emerald-100 text-emerald-700",
  moderate: "bg-amber-100 text-amber-800",
  hard: "bg-orange-100 text-orange-800",
  extreme: "bg-red-100 text-red-700",
};
const DIFF_ORDER = ["easy", "moderate", "hard", "extreme"];

// Every number on this page is read from mountains-data.json so the tables cannot drift apart.
const peaks = fiveGreat.map(m => ({
  slug: m.slug,
  en: m.name.en,
  zh: m.name.zh,
  direction: DIRECTIONS[m.slug],
  province: m.location.province,
  elevation: m.physical.elevation,
  difficulty: m.tourism.difficulty,
  duration: m.tourism.avgVisitDuration,
  ticket: m.tourism.ticketPrice,
  ticketCny: Number((m.tourism.ticketPrice.match(/\d+/) || [0])[0]),
  season: m.tourism.bestSeason,
  unesco: m.culture.unescoSite ? m.culture.yearDesignated : null,
  bestFor: BEST_FOR[m.slug],
}));

const climbOrder = [...peaks].sort((a, b) => DIFF_ORDER.indexOf(a.difficulty) - DIFF_ORDER.indexOf(b.difficulty));
const totalTickets = peaks.reduce((s, p) => s + p.ticketCny, 0);
const dayRange = peaks.reduce(([lo, hi], p) => {
  const nums = (p.duration.match(/\d+/g) || []).map(Number);
  return [lo + (nums[0] ?? 0), hi + (nums[nums.length - 1] ?? nums[0] ?? 0)];
}, [0, 0]);
const highest = peaks.reduce((a, b) => (b.elevation > a.elevation ? b : a));
const lowest = peaks.reduce((a, b) => (b.elevation < a.elevation ? b : a));
const toughest = climbOrder[climbOrder.length - 1];
const otherFour = climbOrder.filter(p => p.difficulty !== toughest.difficulty);

const daoistSlugs = mountains.filter(m => m.culture.type.includes("Daoist")).map(m => m.slug);
const buddhistSlugs = mountains.filter(m => m.culture.type.some(t => ["Buddhist", "Tibetan Buddhist"].includes(t))).map(m => m.slug);
const alsoDaoist = peaks.filter(p => daoistSlugs.includes(p.slug)).map(p => p.en);
const alsoBuddhist = peaks.filter(p => buddhistSlugs.includes(p.slug)).map(p => p.en);

const ADJECTIVE: Record<string, string> = { East: "eastern", West: "western", South: "southern", North: "northern", Center: "central" };
const andList = (arr: string[]) => arr.length < 3 ? arr.join(" and ") : arr.slice(0, -1).join(", ") + ", and " + arr[arr.length - 1];
const provinces = [...new Set(peaks.map(p => p.province))];
const elevLo = Math.min(...peaks.map(p => p.elevation));
const elevHi = Math.max(...peaks.map(p => p.elevation));
const ticketLo = Math.min(...peaks.map(p => p.ticketCny));
const ticketHi = Math.max(...peaks.map(p => p.ticketCny));
const pageDesc = `Five Great Mountains (Wuyue) compared: elevations ${elevLo.toLocaleString()}-${elevHi.toLocaleString()}m, entry CNY ${ticketLo}-${ticketHi}, difficulty, days needed, and whether they are the Five Sacred Mountains.`;

const faqs = [
  {
    q: "What are the Five Great Mountains of China?",
    a: `The Wuyue (五岳) are ${andList(peaks.map(p => `the ${ADJECTIVE[p.direction]} ${p.en}`))}. Each one holds a direction in early Chinese cosmology. ${highest.en} is the tallest at ${highest.elevation.toLocaleString()}m; ${lowest.en} the shortest at ${lowest.elevation.toLocaleString()}m.`,
  },
  {
    q: "Are the Five Great Mountains the same as the Five Sacred Mountains?",
    a: "Yes — both renderings translate the same Chinese name, Wuyue (五岳). It is a separate set from the Buddhist and Daoist sacred mountains, although individual peaks appear on more than one list.",
  },
  {
    q: "Which of the Five Great Mountains is the hardest to climb?",
    a: `${toughest.en} in ${toughest.province}, rated extreme: sheer granite faces, exposed ridges and the plank walk bolted to a vertical cliff. The other four — ${andList(otherFour.map(p => p.en))} — are all rated moderate, so the real difference between them is what you came to see rather than how hard you have to work.`,
  },
  {
    q: "How many days do you need to visit all five?",
    a: `Each peak asks for about a day or two on the hill, so all five come to roughly ${dayRange[0]}-${dayRange[1]} days of walking. They sit in ${provinces.length} provinces — ${andList(provinces)} — with long rail or flight hops between them, so most visitors pick two or three.`,
  },
  {
    q: "What do the entry tickets cost for all Five Great Mountains?",
    a: `Standard entry is ${andList(peaks.map(p => `${p.en} ${p.ticket}`))}, which comes to CNY ${totalTickets} for the set. Every figure is the gate ticket on its own — Taishan, for example, charges its mountain road bus per leg rather than folding it into admission.`,
  },
  {
    q: "Which of the Five Great Mountains are UNESCO World Heritage Sites?",
    a: `${peaks.filter(p => p.unesco).map(p => `${p.en} (inscribed ${p.unesco})`).join(" and ")} carry World Heritage listing. The other three are not UNESCO sites, though each is a nationally designated scenic area.`,
  },
];
---
<BaseLayout title="Five Great Mountains of China: Compare All 5 Sacred Peaks" description={pageDesc}>
<section class="pt-12 pb-20">
<div class="max-w-[1400px] mx-auto px-6">
<h1 class="text-4xl font-bold tracking-tighter text-slate-900">The Five Great Mountains (Wuyue)</h1>
<p class="mt-3 text-slate-500 max-w-[55ch]">For over 4000 years, emperors made pilgrimages to these five peaks, poets composed verses about them, and ordinary people climbed their steps seeking blessing and perspective. They are the spiritual backbone of Chinese civilization.</p>

<div class="mt-10 overflow-x-auto">
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-6">Five Great Mountains at a Glance</h2>
<div class="hidden lg:block">
<table class="w-full text-sm">
<thead><tr class="border-b border-slate-200 text-left text-xs text-slate-600 uppercase tracking-wider">
<th class="pb-3 font-medium pr-4">Mountain</th>
<th class="pb-3 font-medium px-2">Direction</th>
<th class="pb-3 font-medium px-2">Province</th>
<th class="pb-3 font-medium px-2">Elevation</th>
<th class="pb-3 font-medium px-2">Difficulty</th>
<th class="pb-3 font-medium px-2">Typical visit</th>
<th class="pb-3 font-medium px-2">Entry ticket</th>
<th class="pb-3 font-medium px-2">UNESCO</th>
</tr></thead>
<tbody class="divide-y divide-slate-100">
{peaks.map(p => (
<tr>
<td class="py-3 pr-4 font-medium text-slate-900">{p.en} ({p.zh})</td>
<td class="py-3 px-2 text-slate-600">{p.direction}</td>
<td class="py-3 px-2 text-slate-600">{p.province}</td>
<td class="py-3 px-2 text-slate-600">{p.elevation.toLocaleString()}m</td>
<td class="py-3 px-2"><span class={`text-xs px-2 py-0.5 rounded-full ${DIFF_BADGE[p.difficulty]}`}>{p.difficulty[0].toUpperCase() + p.difficulty.slice(1)}</span></td>
<td class="py-3 px-2 text-slate-600">{p.duration}</td>
<td class="py-3 px-2 text-slate-600">{p.ticket}</td>
<td class="py-3 px-2">{p.unesco ? <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-800">{p.unesco}</span> : <span class="text-slate-300 text-xs px-2">-</span>}</td>
</tr>
))}
</tbody>
</table>
</div>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:hidden gap-3">
{peaks.map(p => (
<div class="bg-white border border-slate-200 rounded-xl p-4">
<span class="font-semibold text-slate-900 text-sm">{p.en} {p.zh}</span>
<span class="text-xs text-slate-600 mt-1 block">{p.direction} · {p.province} · {p.elevation.toLocaleString()}m · {p.difficulty[0].toUpperCase() + p.difficulty.slice(1)}</span>
<span class="text-xs text-slate-500 mt-1 block">{p.duration} · entry {p.ticket}</span>
<span class="text-xs text-slate-500">Best for: {p.bestFor}</span>
</div>
))}
</div>
</div>

<div class="mt-10">
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-3">Climbing the Five: Which Is the Hardest?</h2>
<p class="text-sm text-slate-600 mb-6 max-w-[70ch]">Four of the five — {andList(otherFour.map(p => p.en))} — carry the same <strong>moderate</strong> rating. {toughest.en} is the outlier at <strong>extreme</strong>. Grouped by difficulty, easiest first, with the visit length and entry price each guide uses:</p>
<ol class="space-y-3">
{climbOrder.map((p, i) => (
<li class="flex items-start gap-4 bg-white border border-slate-200 rounded-xl p-4">
<span class="text-lg font-bold text-accent shrink-0 w-6">{i + 1}</span>
<div class="flex-1 min-w-0">
<p class="font-semibold text-slate-900 text-sm">
<a href={`/mountains/${p.slug}/`} class="hover:text-accent no-underline">{p.en}</a>
<span class="text-xs font-normal text-slate-500 ml-2">{p.direction} · {p.province} · {p.elevation.toLocaleString()}m</span>
</p>
<p class="text-xs text-slate-600 mt-1">
Rated <span class={`px-2 py-0.5 rounded-full ${DIFF_BADGE[p.difficulty]}`}>{p.difficulty}</span>
· plan {p.duration} · entry {p.ticket}
· best months {p.season.join(", ")}
</p>
</div>
</li>
))}
</ol>
<p class="text-xs text-slate-500 mt-4">Every elevation, rating, visit length and ticket price here is the same figure that mountain's own guide page uses, so the two can never disagree. Route-by-route climb times are on the individual pages.</p>
</div>

<div class="mt-10 bg-slate-50 rounded-2xl border border-slate-200 p-6">
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-4">Which of the Five Should You Visit?</h2>
<div class="grid sm:grid-cols-2 gap-4 text-sm">
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">First time in China?</strong> Choose <a href="/mountains/taishan/" class="text-accent hover:underline no-underline">Mount Tai</a> — the most iconic, 72 emperors climbed it, stunning sunrise.</span></div>
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">Want adrenaline?</strong> Choose <a href="/mountains/huashan/" class="text-accent hover:underline no-underline">Mount Hua</a> — cliff plank walk, narrow ridges, extreme hiking.</span></div>
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">Traveling with family?</strong> Choose <a href="/mountains/hengshan-hunan/" class="text-accent hover:underline no-underline">Mount Heng (Hunan)</a> — easy paths, 200+ temples, cable car access.</span></div>
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">Love architecture?</strong> Choose <a href="/mountains/hengshan-shanxi/" class="text-accent hover:underline no-underline">Mount Heng (Shanxi)</a> — the 1,500-year-old Hanging Temple suspended from a cliff.</span></div>
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">Into martial arts & Zen?</strong> Choose <a href="/mountains/songshan/" class="text-accent hover:underline no-underline">Mount Song</a> — birthplace of Shaolin kung fu and Chan Buddhism.</span></div>
<div class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">→</span><span><strong class="text-slate-800">Want them all?</strong> Follow the ancient emperors' route: Tai → Hua → Heng (S) → Heng (N) → Song.</span></div>
</div>
</div>

<div class="mt-12">
<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-6">Meet the Five</h2>
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
{fiveGreat.map(m => (
<div class="flex flex-col sm:flex-row gap-6 bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-accent hover:shadow-md transition-all">
<a href={`/mountains/${m.slug}/`} class="sm:w-48 shrink-0 aspect-[4/3] sm:aspect-auto overflow-hidden bg-slate-100 no-underline">
<img src={thumb(m.images[0]?.src, 960)} alt={m.images[0]?.alt ?? m.name.en} loading="lazy" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
</a>
<div class="p-5 sm:p-4 flex flex-col justify-between flex-1">
<div>
<a href={`/mountains/${m.slug}/`} class="no-underline"><h3 class="font-semibold text-slate-900 text-lg hover:text-accent transition-colors">{m.name.en}<span class="text-sm text-slate-600 ml-2">{m.name.zh}</span></h3></a>
<p class="text-sm text-slate-500 mt-2 line-clamp-3">{m.tagline}</p>
</div>
<div class="flex flex-wrap items-center gap-2 mt-3">
<span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">{m.location.province}</span>
<span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">{m.physical.elevation.toLocaleString()}m</span>
<span class="text-xs px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">Score {m.rating.overall}/5</span>
</div>
</div>
</div>
))}
</div>

<h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-16 mb-6">Why These Five? The History</h2>
<div class="prose prose-slate max-w-none">
<p class="text-slate-600 leading-relaxed">The concept of the Five Great Mountains (Wuyue) dates back to the Warring States period (475-221 BC). Ancient Chinese cosmology assigned each mountain a cardinal direction — east, west, south, north, and center — and believed they were pillars holding up the heavens. Emperors would travel to each mountain to perform the Fengshan sacrifice, the most sacred ritual in Chinese state religion, to legitimize their rule and communicate with heaven.</p>

<h3 class="text-lg font-semibold text-slate-900 mt-8 mb-3">The Five Mountains by Direction</h3>
<ul class="space-y-4 text-slate-600">
<li class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">East</span><span><strong class="text-slate-800">Mount Tai</strong> — The most revered. "If Mount Tai is stable, so is the entire country." 72 emperors climbed its 6,600+ steps. First among equals.</span></li>
<li class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">West</span><span><strong class="text-slate-800">Mount Hua</strong> — The most dramatic. Five granite peaks connected by narrow ridges. Famous for the heart-stopping Plank Walk bolted to a vertical cliff face.</span></li>
<li class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">South</span><span><strong class="text-slate-800">Mount Heng (Hunan)</strong> — The most serene. Over 200 temples and shrines scatter its slopes. A center of both Buddhist and Daoist practice for 1,500+ years.</span></li>
<li class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">North</span><span><strong class="text-slate-800">Mount Heng (Shanxi)</strong> — Home to the 1,500-year-old Hanging Temple, a monastery literally suspended from a cliff face. A geological oddity with dramatic horizontal rock strata.</span></li>
<li class="flex items-start gap-3"><span class="text-accent font-bold shrink-0 mt-0.5">Center</span><span><strong class="text-slate-800">Mount Song</strong> — The birthplace of Shaolin kung fu and Zen (Chan) Buddhism. The Shaolin Temple at its base is one of the world's most famous monasteries.</span></li>
</ul>
</div>
</div>

<div class="mt-16">
<h2 id="faq" class="scroll-mt-36 text-2xl font-bold tracking-tighter text-slate-900 mb-6">Five Great Mountains: Common Questions</h2>
<div class="space-y-4">
  {faqs.map((faq, i) => (
    <details class="group border border-slate-200 rounded-xl overflow-hidden" open={i === 0}>
      <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50 transition-colors list-none">
        <span class="font-medium text-slate-900 text-sm">{faq.q}</span>
        <span class="text-slate-600 group-open:rotate-180 transition-transform text-lg">+</span>
      </summary>
      <div class="px-4 pb-4 text-slate-600 text-sm leading-relaxed">{faq.a}</div>
    </details>
  ))}
</div>
<p class="text-sm text-slate-600 mt-6">Some of these peaks sit on more than one sacred list: {andList(alsoDaoist)} also appear{alsoDaoist.length === 1 ? "s" : ""} among the <a href="/collections/daoist-mountains/" class="text-accent hover:underline no-underline font-medium">Daoist holy mountains</a>, and {andList(alsoBuddhist)} among the <a href="/collections/buddhist-mountains/" class="text-accent hover:underline no-underline font-medium">Buddhist sacred sites</a>.</p>
</div>
</div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
"@context": "https://schema.org",
"@graph": [
  {
    "@type": "CollectionPage",
    "@id": "https://www.chinese-mountains.com/collections/five-great-mountains/",
    "url": "https://www.chinese-mountains.com/collections/five-great-mountains/",
    "name": "The Five Great Mountains of China",
    "description": "Comprehensive guide to the Five Great Mountains (Wuyue) of China: Mount Tai, Mount Hua, Mount Heng (Hunan), Mount Heng (Shanxi), and Mount Song.",
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": peaks.map((p, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "url": `https://www.chinese-mountains.com/mountains/${p.slug}/`,
        "name": p.en
      }))
    }
  },
  {
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
]
})} />
</BaseLayout>
