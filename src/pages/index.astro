---
import BaseLayout from "../layouts/BaseLayout.astro";
import MountainQuiz from "../components/MountainQuiz.tsx";
import HeroSearch from "../components/HeroSearch.tsx";
import SeasonalCalendar from "../components/SeasonalCalendar.tsx";
import InteractiveMap from "../components/InteractiveMap.tsx";
import MountainCard from "../components/MountainCard.astro";
import { mountains, vibeGroups, allRegions } from "../data/mountains";
import { allPosts } from "../data/blog";
import { allGuides } from "../data/guides";

const featured = mountains.sort((a, b) => b.rating.overall - a.rating.overall).slice(0, 6);
const topSix = mountains.sort((a, b) => b.rating.overall - a.rating.overall).slice(0, 6);
const topTen = mountains.sort((a, b) => b.rating.overall - a.rating.overall).slice(0, 10);
const unescoCount = mountains.filter(m => m.culture.unescoSite).length;
const provinceCount = new Set(mountains.map(m => m.location.province)).size;

// Photo strip: mountains with real multi-photo galleries
const galleryMountains = mountains
  .filter(m => m.images.length > 1)
  .sort((a, b) => b.rating.overall - a.rating.overall)
  .slice(0, 10);

// Records & leaderboards
const byElevation = [...mountains].sort((a, b) => b.physical.elevation - a.physical.elevation);
const highest = byElevation[0];
const topElevations = byElevation.slice(0, 5);
const bestSceneryPeak = [...mountains].sort((a, b) => (b.rating.scenery - a.rating.scenery) || (b.rating.overall - a.rating.overall))[0];
const extremePeaks = mountains.filter(m => m.tourism.difficulty === "extreme").sort((a, b) => b.rating.overall - a.rating.overall);
const unescoPeaks = mountains.filter(m => m.culture.unescoSite);
const oldestUnesco = [...unescoPeaks].sort((a, b) => (a.culture.yearDesignated ?? 9999) - (b.culture.yearDesignated ?? 9999))[0];
const buddhistCount = mountains.filter(m => m.culture.type.some(t => t === "Buddhist" || t === "Tibetan Buddhist")).length;
const daoistCount = mountains.filter(m => m.culture.type.includes("Daoist")).length;
const easyCount = mountains.filter(m => m.tourism.difficulty === "easy").length;

// Latest editorial content
const latestPosts = [...allPosts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).slice(0, 3);
const homeGuides = allGuides.slice(0, 3);

const diffColor = (d: string) => ({
  easy: "bg-emerald-100 text-emerald-700",
  moderate: "bg-amber-100 text-amber-700",
  hard: "bg-orange-100 text-orange-700",
  extreme: "bg-red-100 text-red-700",
}[d] || "bg-slate-100 text-slate-600");

function suitsTags(m: typeof mountains[0]): string {
  const tags: string[] = [];
  if (m.rating.scenery >= 5) tags.push("Photographers");
  if (m.culture.type.some((t: string) => t === "Buddhist" || t === "Daoist")) tags.push("Culture lovers");
  if (m.tourism.difficulty === "easy" || m.tourism.difficulty === "moderate") tags.push("Families");
  if (m.tourism.difficulty === "hard" || m.tourism.difficulty === "extreme") tags.push("Adventurers");
  if (m.culture.unescoSite) tags.push("Heritage seekers");
  return tags.slice(0, 2).join(", ");
}
---

<BaseLayout
  title="Chinese Mountains - Explore Every Famous Peak in China"
  description="Discover China's most breathtaking mountains. Interactive map, search by name, detailed guides, photos, and rankings for every famous peak in China."
>
  <section class="min-h-[calc(100dvh-4rem)] flex items-center">
    <div class="max-w-[1400px] mx-auto px-6 w-full grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="max-w-[32rem]">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-tight text-slate-900 text-balance">
          Discover Your Perfect <span class="text-accent">Chinese Mountain</span>
        </h1>
        <p class="mt-6 text-lg text-slate-500 leading-relaxed max-w-[46ch]">
          The only site that helps you <em class="not-italic font-medium text-slate-700">choose</em> a mountain, not just list them. Search by name, explore the map, or answer 3 questions to find your match.
        </p>
        <div class="mt-8">
          <HeroSearch client:load />
        </div>
        <div class="flex flex-wrap items-center gap-3 mt-6">
          <a href="#quiz" class="inline-flex items-center gap-2 px-5 py-3 bg-accent text-white rounded-lg font-medium text-sm hover:bg-accent-dark transition-colors no-underline shadow-sm">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 1 0 6 8c0 1.3.5 2.6 1.5 3.5.8.8 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
            Take the Quiz
          </a>
          <a href="/explore" class="inline-flex items-center gap-2 px-5 py-3 bg-slate-100 text-slate-700 rounded-lg font-medium text-sm hover:bg-slate-200 transition-colors no-underline">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Explore Map
          </a>
        </div>
        <div class="flex flex-wrap items-center gap-2 mt-6 text-xs text-slate-400">
          <span class="inline-flex items-center gap-1"><span class="font-semibold text-slate-600">{mountains.length}</span> peaks</span>
          <span class="text-slate-300">-</span>
          <span class="inline-flex items-center gap-1"><span class="font-semibold text-slate-600">7</span> regions</span>
          <span class="text-slate-300">-</span>
          <span class="inline-flex items-center gap-1"><span class="font-semibold text-slate-600">{unescoCount}</span> UNESCO sites</span>
          <span class="text-slate-300">-</span>
          <span>Free. No bookings, no sales pitches.</span>
        </div>
      </div>
      <div class="relative lg:h-[600px] h-[400px] shadow-2xl rounded-2xl">
        <InteractiveMap client:load className="h-full" />
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
        <div>
          <h2 class="text-3xl font-bold tracking-tighter text-slate-900">Photos of China's Mountains</h2>
          <p class="mt-2 text-slate-500 max-w-[62ch]">Real photography from Huangshan's sea of clouds to the Himalaya's 8,000-meter giants — every picture links to a complete guide.</p>
        </div>
        <a href="/gallery" class="text-sm font-medium text-accent hover:underline no-underline">View the full gallery →</a>
      </div>
      <div class="flex gap-4 overflow-x-auto pb-4 -mx-6 px-6 snap-x">
        {galleryMountains.map((m) => (
          <a href={"/mountains/" + m.slug} class="group shrink-0 w-[280px] snap-start no-underline">
            <div class="rounded-xl overflow-hidden bg-slate-200 aspect-[4/3]">
              <img src={m.images[1]?.src ?? m.images[0]?.src} alt={m.images[1]?.alt ?? m.images[0]?.alt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            </div>
            <div class="mt-2 flex items-center justify-between">
              <span class="text-sm font-semibold text-slate-900 group-hover:text-accent transition-colors">{m.name.en}</span>
              <span class="text-xs text-slate-400">{m.images.length} photos</span>
            </div>
            <p class="text-xs text-slate-500 mt-0.5 truncate">{m.location.province} · {m.physical.elevation.toLocaleString()}m</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="max-w-[52rem]">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-slate-900">What Are Chinese Mountains?</h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">China is the most mountainous country on Earth. Roughly two-thirds of its territory is covered by mountains, plateaus, and hills, and its famous peaks have shaped Chinese civilization for over 5,000 years. Unlike the wilderness ranges of North America or Europe, most Chinese mountains are <strong class="text-slate-800">living cultural landscapes</strong> — sacred sites where emperors performed rituals, where Buddhist and Daoist monasteries cling to cliffs, and where poets and painters found their greatest muse.</p>
        <p class="mt-4 text-slate-600 leading-relaxed">This guide covers <strong class="text-slate-800">{mountains.length} famous mountains of China</strong> across {provinceCount} provinces and {allRegions.length} geographic regions — from the granite spires of Huangshan to the 8,000-meter giants of the Himalaya, from the karst pillars of Zhangjiajie to the rainbow strata of Zhangye. Every entry includes elevation, difficulty, best season, ticket prices, transport routes, and cultural context, so you can plan a visit with confidence.</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-8">
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="text-2xl font-bold text-accent">{mountains.length}</div>
            <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider">Famous Peaks</div>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="text-2xl font-bold text-accent">{provinceCount}</div>
            <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider">Provinces</div>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="text-2xl font-bold text-accent">{unescoCount}</div>
            <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider">UNESCO Sites</div>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 p-4">
            <div class="text-2xl font-bold text-accent">7</div>
            <div class="text-xs text-slate-500 mt-1 uppercase tracking-wider">Regions</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tighter text-slate-900">China's Mountain Records</h2>
      <p class="mt-2 text-slate-500 max-w-[62ch]">The statistics behind the legends — highest peaks, best scenery, toughest trails, and oldest heritage, computed from our database of {mountains.length} mountains.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        <a href={"/mountains/" + highest.slug} class="group bg-slate-50 rounded-2xl border border-slate-200 p-5 hover:border-accent hover:shadow-md transition-all no-underline">
          <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Highest Peak</div>
          <div class="mt-2 text-3xl font-bold text-slate-900 group-hover:text-accent transition-colors">{highest.physical.elevation.toLocaleString()}m</div>
          <div class="mt-1 font-semibold text-slate-700">{highest.name.en}</div>
          <p class="mt-1 text-xs text-slate-500">{highest.location.province} · {highest.location.region} region</p>
        </a>
        <a href={"/mountains/" + bestSceneryPeak.slug} class="group bg-slate-50 rounded-2xl border border-slate-200 p-5 hover:border-accent hover:shadow-md transition-all no-underline">
          <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Best Scenery</div>
          <div class="mt-2 text-3xl font-bold text-slate-900 group-hover:text-accent transition-colors">{bestSceneryPeak.rating.scenery}/5</div>
          <div class="mt-1 font-semibold text-slate-700">{bestSceneryPeak.name.en}</div>
          <p class="mt-1 text-xs text-slate-500">Rated on our scenery scale across all {mountains.length} peaks</p>
        </a>
        <a href={"/mountains/" + extremePeaks[0].slug} class="group bg-slate-50 rounded-2xl border border-slate-200 p-5 hover:border-accent hover:shadow-md transition-all no-underline">
          <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Most Extreme</div>
          <div class="mt-2 text-3xl font-bold text-slate-900 group-hover:text-accent transition-colors">{extremePeaks[0].name.en}</div>
          <div class="mt-1 font-semibold text-slate-700">{extremePeaks.length} extreme peaks</div>
          <p class="mt-1 text-xs text-slate-500">Cliff planks, glacier routes & 8,000m ridges</p>
        </a>
        <a href={"/mountains/" + oldestUnesco.slug} class="group bg-slate-50 rounded-2xl border border-slate-200 p-5 hover:border-accent hover:shadow-md transition-all no-underline">
          <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Oldest Heritage Site</div>
          <div class="mt-2 text-3xl font-bold text-slate-900 group-hover:text-accent transition-colors">{oldestUnesco.culture.yearDesignated}</div>
          <div class="mt-1 font-semibold text-slate-700">{oldestUnesco.name.en}</div>
          <p class="mt-1 text-xs text-slate-500">UNESCO World Heritage · {unescoPeaks.length} sites covered</p>
        </a>
      </div>
      <div class="mt-10 grid lg:grid-cols-2 gap-8">
        <div>
          <h3 class="text-lg font-bold tracking-tighter text-slate-900">Highest Mountains in China</h3>
          <div class="mt-4 bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100 overflow-hidden">
            {topElevations.map((m, i) => (
              <a href={"/mountains/" + m.slug} class="flex items-center gap-4 px-5 py-3 hover:bg-slate-50 transition-colors no-underline">
                <span class={"w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-bold " + (i === 0 ? "bg-accent text-white" : "bg-slate-100 text-slate-500")}>{i + 1}</span>
                <span class="flex-1 font-medium text-slate-800">{m.name.en}</span>
                <span class="text-xs text-slate-400 hidden sm:block">{m.location.province}</span>
                <span class="font-bold text-slate-700 text-sm">{m.physical.elevation.toLocaleString()}m</span>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h3 class="text-lg font-bold tracking-tighter text-slate-900">Toughest Mountains in China</h3>
          <div class="mt-4 bg-white rounded-2xl border border-slate-200 divide-y divide-slate-100 overflow-hidden">
            {extremePeaks.map((m, i) => (
              <a href={"/mountains/" + m.slug} class="flex items-center gap-4 px-5 py-3 hover:bg-slate-50 transition-colors no-underline">
                <span class={"w-7 h-7 shrink-0 rounded-full flex items-center justify-center text-xs font-bold " + (i === 0 ? "bg-accent text-white" : "bg-slate-100 text-slate-500")}>{i + 1}</span>
                <span class="flex-1 font-medium text-slate-800">{m.name.en}</span>
                <span class="text-xs text-slate-400 hidden sm:block">{m.tourism.difficulty}</span>
                <span class="font-bold text-slate-700 text-sm">{m.physical.elevation.toLocaleString()}m</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="quiz" class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="max-w-[48rem] mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-slate-900">Which Mountain Is Right for You?</h2>
          <p class="mt-3 text-slate-500 text-base">Answer 3 questions. Get 3 personalized recommendations. No endless lists.</p>
        </div>
        <MountainQuiz client:load />
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[1400px] mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tighter text-slate-900">Browse by Vibe</h2>
      <p class="mt-2 text-slate-500">Choose your mountain mood, not your province.</p>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mt-8">
        {vibeGroups.map((vibe) => {
          const img = mountains.find(m => m.id === vibe.mountainIds[0])?.images[0]?.src;
          const count = vibe.mountainIds.length;
          return {
            vibe, img, count
          };
        }).map(({ vibe, img, count }) => (
          <a href={"/explore?vibe=" + vibe.id} class="group relative rounded-xl overflow-hidden aspect-[3/4] bg-slate-200 no-underline">
            {img && <img src={img} alt={vibe.label} loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />}
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent" />
            <div class="absolute top-3 right-3 bg-black/30 backdrop-blur-sm text-white text-xs px-2 py-0.5 rounded-full">{count}</div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <h3 class="text-white font-semibold text-sm">{vibe.label}</h3>
              <p class="text-white/70 text-xs mt-1">{vibe.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tighter text-slate-900">At a Glance</h2>
      <p class="mt-2 text-slate-500 mb-8">Compare the heavyweights. Click any row to dive deeper.</p>
      <div class="hidden lg:block overflow-x-auto">
        <table class="w-full text-sm">
          <thead><tr class="border-b border-slate-200 text-left text-xs text-slate-400 uppercase tracking-wider">
            <th class="pb-3 font-medium pr-4">Mountain</th>
            <th class="pb-3 font-medium px-2">Elevation</th>
            <th class="pb-3 font-medium px-2">Difficulty</th>
            <th class="pb-3 font-medium px-2">Season</th>
            <th class="pb-3 font-medium px-2">UNESCO</th>
            <th class="pb-3 font-medium px-2">Best for</th>
            <th class="pb-3 font-medium px-2">Score</th>
          </tr></thead>
          <tbody class="divide-y divide-slate-100">
            {topSix.map(m => (
              <tr class="hover:bg-slate-50">
                <td class="py-3 pr-4"><a href={"/mountains/" + m.slug} class="font-medium text-slate-900 hover:text-accent no-underline whitespace-nowrap">{m.name.en}</a></td>
                <td class="py-3 px-2 text-slate-600">{m.physical.elevation.toLocaleString()}m</td>
                <td class="py-3 px-2"><span class={"text-xs px-2 py-0.5 rounded-full " + diffColor(m.tourism.difficulty)}>{m.tourism.difficulty}</span></td>
                <td class="py-3 px-2 text-slate-500 text-xs whitespace-nowrap">{m.tourism.bestSeason.slice(0,2).join(", ")}</td>
                <td class="py-3 px-2">{m.culture.unescoSite ? <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">{m.culture.yearDesignated}</span> : <span class="text-slate-300">-</span>}</td>
                <td class="py-3 px-2 text-slate-500 text-xs max-w-[160px] leading-relaxed">{suitsTags(m)}</td>
                <td class="py-3 px-2 font-semibold text-accent">{m.rating.overall}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="grid grid-cols-2 lg:hidden gap-3 mb-4">
        {topSix.map(m => (
          <a href={"/mountains/" + m.slug} class="flex flex-col bg-white border border-slate-200 rounded-xl p-4 hover:border-accent hover:shadow-sm transition-all no-underline">
            <span class="font-semibold text-slate-900 text-sm">{m.name.en}</span>
            <span class="text-xs text-slate-400 mt-0.5">{m.physical.elevation.toLocaleString()}m - <span class={diffColor(m.tourism.difficulty)}>{m.tourism.difficulty}</span></span>
            {m.culture.unescoSite && <span class="text-xs text-amber-600 mt-1">UNESCO {m.culture.yearDesignated}</span>}
            <span class="text-lg font-bold text-accent mt-2">{m.rating.overall}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-50 border-t border-slate-100">
    <div class="max-w-[1400px] mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tighter text-slate-900">Sacred &amp; Cultural Mountains of China</h2>
      <p class="mt-2 text-slate-500 max-w-[60ch]">For most of Chinese history, mountains were not scenery — they were deities, pilgrimage routes, and places of imperial power. These four traditions explain why.</p>
      <div class="grid md:grid-cols-2 gap-6 mt-10">
        <a href="/collections/five-great-mountains" class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-slate-900 text-lg">The Five Great Mountains (Wuyue)</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">For 4,000 years, Chinese emperors climbed these five peaks — Mount Tai, Mount Hua, Mount Heng (Hunan), Mount Heng (Shanxi), and Mount Song — to perform the Fengshan sacrifice to heaven and earth. Mount Tai is the most storied, with 72 emperors and 12 emperors&rsquo; inscriptions among its 2,000+ stone tablets. Mount Hua adds adrenaline, with its famous cliff-face Plank Walk.</p>
        </a>
        <a href="/collections/buddhist-mountains" class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-slate-900 text-lg">The Four Sacred Buddhist Mountains</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">Mount Wutai, Mount Emei, Mount Putuo, and Mount Jiuhua are the bodhisattva seats of Chinese Buddhism. Mount Wutai&rsquo;s five terraced peaks hosted 360+ temples at its peak; Mount Emei holds the world&rsquo;s tallest bronze Buddha statue. Pilgrims have walked these stone paths for over 1,500 years.</p>
        </a>
        <a href="/collections/daoist-mountains" class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-slate-900 text-lg">Daoist Sacred Mountains</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">Daoism was born among these peaks: Mount Qingcheng, where Zhang Daoling founded the Celestial Masters school in 142 AD; Mount Wudang, the 72-peak complex of martial-arts temples; and Mount Lao, where the legendary Mount Kunlun myths converge with the famous Yin-Yang symbol from the Book of Changes.</p>
        </a>
        <a href="/collections" class="group bg-white rounded-2xl border border-slate-200 p-6 hover:border-accent hover:shadow-md transition-all no-underline">
          <h3 class="font-bold text-slate-900 text-lg">Sacred High-Altitude Peaks of the West</h3>
          <p class="mt-2 text-sm text-slate-600 leading-relaxed">In Tibet and the western ranges, mountains are gods. Mount Kailash, the axis mundi of four religions, is circumnavigated by pilgrims in a 52-km kora. Meili Snow Mountain&rsquo;s Kawagarbo — unclimbed by choice — is the most sacred peak in Tibetan Buddhism, its golden sunrise visible from Feilai Temple.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="py-20">
    <div class="max-w-[1400px] mx-auto px-6">
      <h2 class="text-3xl font-bold tracking-tighter text-slate-900">Explore by Type</h2>
