---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MountainCard from "../../components/MountainCard.astro";
import DetailSubNav from "../../components/detail/DetailSubNav.astro";
import VerifiedBadge from "../../components/detail/VerifiedBadge.astro";
import VerdictSection from "../../components/detail/VerdictSection.astro";
import PersonaSection from "../../components/detail/PersonaSection.astro";
import RouteCompare from "../../components/detail/RouteCompare.astro";
import ItineraryPlanner from "../../components/detail/ItineraryPlanner.tsx";
import StayCompare from "../../components/detail/StayCompare.astro";
import CostSection from "../../components/detail/CostSection.astro";
import SeasonCompare from "../../components/detail/SeasonCompare.astro";
import VsSection from "../../components/detail/VsSection.astro";
import PackingChecklist from "../../components/detail/PackingChecklist.tsx";
import { mountains, getMountain, getMountainsByRegion, getMountainDepth } from "../../data/mountains";

export function getStaticPaths() {
  return mountains.map((m) => ({ params: { slug: m.slug } }));
}

const { slug } = Astro.params;
const mountain = getMountain(slug!);
if (!mountain) return Astro.redirect("/404");

const depth = getMountainDepth(slug!);

const related = getMountainsByRegion(mountain.location.region)
  .filter((m) => m.id !== mountain.id)
  .sort((a, b) => b.rating.overall - a.rating.overall)
  .slice(0, 3);

const title = mountain!.name.en + " (" + mountain!.name.zh + ") - Complete Guide";
const desc = mountain!.metaDescription || mountain!.description.slice(0, 160).trimEnd().replace(/\s+\S+$/, '');
const siteUrl = "https://www.chinese-mountains.com";
const pageUrl = siteUrl + "/mountains/" + mountain.slug;
const heroImage = mountain.images[0]?.src ? siteUrl + mountain.images[0].src : undefined;
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: mountain.faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a }
  }))
};
const navSections = depth
  ? [
      { id: "verdict", label: "Verdict" },
      { id: "personas", label: "Who It's For" },
      { id: "routes", label: "Routes" },
      { id: "itineraries", label: "Itineraries" },
      { id: "stays", label: "Where to Stay" },
      { id: "costs", label: "Costs" },
      { id: "seasons", label: "Seasons" },
      { id: "vs", label: "Compare" },
      { id: "faq", label: "FAQ" },
    ]
  : [{ id: "faq", label: "FAQ" }];
---

<BaseLayout title={title} description={desc} ogImage={heroImage}>
  <section class="pt-8 pb-20">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="max-w-[56rem] mx-auto">
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
          <a href="/" class="hover:text-slate-600 no-underline">Home</a>
          <span>/</span>
          <a href="/explore/" class="hover:text-slate-600 no-underline">Mountains</a>
          <span>/</span>
          <span class="text-slate-600">{mountain.name.en}</span>
        </nav>

        <div class="grid lg:grid-cols-3 gap-8 mb-12">
          <div class="lg:col-span-2">
            <div class="aspect-[16/9] rounded-2xl overflow-hidden bg-slate-200 mb-3">
              <img
                id="hero-photo"
                src={mountain.images[0]?.src ?? "/images/placeholder.jpg"}
                alt={mountain.images[0]?.alt ?? mountain.name.en}
                class="w-full h-full object-cover"
              />
            </div>
            <p id="photo-credit" class="text-xs text-slate-400 mb-4">{mountain.images[0]?.credit ? "Photo: " + mountain.images[0].credit : ""}</p>
            {mountain.images.length > 1 && (
              <div class="flex gap-2 mb-6 overflow-x-auto pb-1" role="tablist" aria-label="Photo gallery">
                {mountain.images.map((img, i) => (
                  <button
                    type="button"
                    class:list={[
                      "gallery-thumb shrink-0 w-24 h-16 rounded-lg overflow-hidden border-2 transition cursor-pointer",
                      i === 0 ? "border-slate-800" : "border-transparent hover:border-slate-300",
                    ]}
                    data-src={img.src}
                    data-alt={img.alt}
                    data-credit={img.credit ?? ""}
                    aria-label={"View photo " + (i + 1)}
                  >
                    <img src={img.src} alt="" class="w-full h-full object-cover" loading="lazy" />
                  </button>
                ))}
              </div>
            )}
          </div>
          <div class="lg:col-span-1">
            <div class="bg-white border border-slate-200 rounded-xl p-6 sticky top-24">
              <h1 class="text-2xl font-bold tracking-tighter text-slate-900 leading-tight">{mountain.name.en}</h1>
              <p class="text-sm text-slate-400 mt-1">{mountain.name.zh}</p>
              <p class="text-sm text-slate-500 mt-3 leading-relaxed">{mountain.tagline}</p>

              <div class="mt-6 space-y-3">
                {[
                  { label: "Elevation", value: mountain.physical.elevation.toLocaleString() + "m" },
                  { label: "Province", value: mountain.location.province },
                  { label: "Difficulty", value: mountain.tourism.difficulty.charAt(0).toUpperCase() + mountain.tourism.difficulty.slice(1) },
                  { label: "Best Season", value: mountain.tourism.bestSeason.join(", ") },
                  { label: "Duration", value: mountain.tourism.avgVisitDuration },
                ].map((row) => (
                  <div class="flex items-center justify-between py-2 border-b border-slate-100 last:border-0">
                    <span class="text-xs text-slate-400 uppercase tracking-wider">{row.label}</span>
                    <span class="text-sm font-medium text-slate-700">{row.value}</span>
                  </div>
                ))}
              </div>

              <div class="mt-6 flex gap-2 flex-wrap">
                <span class="text-xs px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">
                  Scenery {mountain.rating.scenery}/5
                </span>
                <span class="text-xs px-2 py-0.5 rounded-full bg-blue-100 text-blue-700">
                  Hiking {mountain.rating.hikingExperience}/5
                </span>
                {mountain.culture.unescoSite && (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">UNESCO</span>
                )}
                {depth && (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-slate-900 text-white">
                    Editor {depth.verdict.score}/10
                  </span>
                )}
              </div>

              {depth && (
                <div class="mt-5 pt-4 border-t border-slate-100">
                  <VerifiedBadge date={depth.verifiedDate} />
                </div>
              )}
            </div>
          </div>
        </div>

        {depth && (
          <>
            <div class="max-w-[48rem] mx-auto">
              <VerdictSection depth={depth} name={mountain.name.en} />
            </div>
            <div class="mt-10">
              <DetailSubNav sections={navSections} />
            </div>
          </>
        )}

        <div class="max-w-[48rem] mx-auto">
          <div class="prose prose-slate max-w-none">
            <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-4">About {mountain.name.en}</h2>
            <p class="text-slate-600 leading-relaxed">{mountain.description}</p>

            <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-4">Mountain Facts</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-4">
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Geology</div>
                <div class="mt-1 text-sm text-slate-700">{mountain.physical.geology}</div>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Protected Area</div>
                <div class="mt-1 text-sm text-slate-700">{mountain.physical.area}</div>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Nearest City</div>
                <div class="mt-1 text-sm text-slate-700">{mountain.location.nearestCity}</div>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Entry Ticket</div>
                <div class="mt-1 text-sm text-slate-700">{mountain.tourism.ticketPrice}</div>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">UNESCO Status</div>
                <div class="mt-1 text-sm text-slate-700">{mountain.culture.unescoSite ? "World Heritage Site since " + mountain.culture.yearDesignated : "Not designated"}</div>
              </div>
              <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                <div class="text-xs uppercase tracking-wider text-slate-400 font-medium">Our Ratings</div>
                <div class="mt-1 text-sm text-slate-700">Scenery {mountain.rating.scenery}/5 · Hiking {mountain.rating.hikingExperience}/5 · Culture {mountain.rating.culturalValue}/5 · Access {mountain.rating.accessibility}/5</div>
              </div>
            </div>

            {mountain.culture.significance && (
              <>
                <h3 class="text-lg font-semibold text-slate-900 mt-8 mb-3">Cultural Significance</h3>
                <p class="text-slate-600 leading-relaxed">{mountain.culture.significance}</p>
              </>
            )}

            <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-4">Highlights</h2>
            <ul class="space-y-2">
              {mountain.highlights.map((h) => (
                <li class="flex items-start gap-2 text-slate-600">
                  <span class="text-accent mt-1 shrink-0">&#8226;</span>
                  {h}
                </li>
              ))}
            </ul>

            {!depth && mountain.whenToGo && (
              <>
                <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-4">When to Go</h2>
                <p class="text-slate-600 leading-relaxed whitespace-pre-line">{mountain.whenToGo}</p>
              </>
            )}
          </div>

          {depth && (
            <>
              <PersonaSection personas={depth.personas} />
              <RouteCompare routes={depth.routes} />
              <section id="itineraries" class="scroll-mt-36 mt-16">
                <h2 class="text-2xl font-bold tracking-tighter text-slate-900">Plan your trip: day-by-day</h2>
                <p class="mt-2 text-slate-500 text-sm max-w-[60ch]">Three tested ways to see the mountain, from a rushed day trip to a full canyon expedition. Switch tabs to compare.</p>
                <div class="mt-6">
                  <ItineraryPlanner itineraries={depth.itineraries} client:load />
                </div>
              </section>
              <StayCompare stays={depth.stays} />
              <section id="costs" class="scroll-mt-36 mt-16">
                <h2 class="text-2xl font-bold tracking-tighter text-slate-900">What it really costs</h2>
                <p class="mt-2 text-slate-500 text-sm max-w-[60ch]">Straight price ranges for a per-person trip — three tested styles and every charge spelled out. No math required.</p>
                <div class="mt-6">
                  <CostSection costs={depth.costs} />
                </div>
              </section>
              <SeasonCompare seasons={depth.seasons} />
              <VsSection comparisons={depth.comparisons} />
              <section id="protips" class="scroll-mt-36 mt-16">
                <h2 class="text-2xl font-bold tracking-tighter text-slate-900">Editor's pro tips</h2>
                <div class="mt-6 space-y-3">
                  {depth.proTips.map((tip) => (
                    <div class="flex items-start gap-3 bg-white border border-slate-200 rounded-xl p-4">
                      <span class="shrink-0 w-6 h-6 rounded-full bg-accent-100 text-accent flex items-center justify-center text-xs font-bold mt-0.5">!</span>
                      <p class="text-sm text-slate-600 leading-relaxed">{tip}</p>
                    </div>
                  ))}
                </div>
              </section>
              <section class="mt-16">
                <PackingChecklist items={depth.packing} storageKey={`packing-${mountain.slug}`} client:load />
              </section>
            </>
          )}

          <div class="prose prose-slate max-w-none">
            <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-4">How to Get There</h2>
            <p class="text-slate-600 leading-relaxed whitespace-pre-line">{mountain.howToGetThere}</p>

            {mountain.faqs.length > 0 && (
              <>
                <h2 id="faq" class="scroll-mt-36 text-2xl font-bold tracking-tighter text-slate-900 mt-12 mb-6">Frequently Asked Questions</h2>
                <div class="space-y-4">
                  {mountain.faqs.map((faq, i) => (
                    <details class="group border border-slate-200 rounded-xl overflow-hidden" open={i === 0}>
                      <summary class="flex items-center justify-between p-4 cursor-pointer hover:bg-slate-50 transition-colors list-none">
                        <span class="font-medium text-slate-900 text-sm">{faq.q}</span>
                        <span class="text-slate-400 group-open:rotate-180 transition-transform text-lg">+</span>
                      </summary>
                      <div class="px-4 pb-4 text-slate-600 text-sm leading-relaxed">{faq.a}</div>
                    </details>
                  ))}
                </div>
              </>
            )}
          </div>

          {related.length > 0 && (
            <div class="mt-16 pt-12 border-t border-slate-200">
              <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-6">You May Also Like</h2>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
                {related.map((m) => (
                  <MountainCard
                    name={m.name.en}
                    zhName={m.name.zh}
                    tagline={m.tagline}
                    imageSrc={m.images[0]?.src ?? "/images/placeholder.jpg"}
                    imageAlt={m.images[0]?.alt ?? m.name.en}
                    elevation={m.physical.elevation}
                    province={m.location.province}
                    difficulty={m.tourism.difficulty}
                    overall={m.rating.overall}
                    slug={m.slug}
                  />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.chinese-mountains.com/" },
      { "@type": "ListItem", "position": 2, "name": "Mountains", "item": "https://www.chinese-mountains.com/explore" },
      { "@type": "ListItem", "position": 3, "name": mountain.name.en }
    ]
  })} />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "@id": pageUrl,
    name: mountain.name.en,
    description: mountain.description,
    url: pageUrl,
    image: heroImage,
    geo: {
      "@type": "GeoCoordinates",
      latitude: mountain.location.coordinates.lat,
      longitude: mountain.location.coordinates.lng,
    },
    address: {
      "@type": "PostalAddress",
      addressRegion: mountain.location.province,
      addressCountry: "CN",
    },
    ...(mountain.culture.unescoSite ? { additionalProperty: { "@type": "PropertyValue", name: "UNESCO World Heritage", value: String(mountain.culture.yearDesignated) } } : {}),
  })} />

  {depth && depth.routes.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      name: "Ways to reach " + mountain.name.en,
      itemListElement: depth.routes.map((r, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: r.name,
        description: r.bestFor,
      })),
    })} />
  )}

  {depth && depth.itineraries.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TouristTrip",
      name: mountain.name.en + " travel itineraries",
      description: "Tested day-by-day itineraries for " + mountain.name.en,
      itinerary: depth.itineraries.map((it) => ({
        "@type": "Itinerary",
        name: it.title + " (" + it.days + " day" + (it.days > 1 ? "s" : "") + ")",
        description: it.suitable + ". " + it.note,
        itemListElement: it.steps.map((s, i) => ({
          "@type": "ListItem",
          position: i + 1,
          name: s.title,
          description: s.detail,
        })),
      })),
    })} />
  )}
</BaseLayout>

<script>
  // Photo gallery: click a thumbnail to swap the hero image
  const hero = document.getElementById("hero-photo");
  const credit = document.getElementById("photo-credit");
  const thumbs = document.querySelectorAll(".gallery-thumb");
  thumbs.forEach((t) => {
    t.addEventListener("click", () => {
      if (hero) {
        hero.src = t.dataset.src ?? hero.src;
        hero.alt = t.dataset.alt ?? hero.alt;
      }
      if (credit && t.dataset.credit) {
        credit.textContent = "Photo: " + t.dataset.credit;
      }
      thumbs.forEach((x) => {
        x.classList.remove("border-slate-800");
        x.classList.add("border-transparent");
      });
      t.classList.add("border-slate-800");
      t.classList.remove("border-transparent");
    });
  });
</script>
