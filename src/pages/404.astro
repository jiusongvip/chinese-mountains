---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist. Browse our mountain guides, interactive map, and travel tips instead." noindex skipOG>
<section class="min-h-[60dvh] flex items-center justify-center">
<div class="text-center">
<h1 class="text-6xl font-bold text-slate-200">404</h1>
<p class="mt-4 text-slate-500">This trail does not exist. Let us get you back on track.</p>
<a href="/" class="inline-block mt-6 px-5 py-3 bg-accent text-white rounded-lg font-medium text-sm hover:bg-accent-dark no-underline">Back to Home</a>
</div>
</section>
</BaseLayout>
