---
import { allPosts, getPost, type BlogPost } from "../../data/blog";
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return allPosts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = getPost(slug!);
if (!post) return Astro.redirect("/404");
---

<BaseLayout title={`${post.title} | Chinese Mountains Blog`} description={post.excerpt}>
  <section class="pt-8 pb-20">
    <div class="max-w-[1400px] mx-auto px-6">
      <div class="max-w-[48rem] mx-auto">
        <nav class="flex items-center gap-2 text-sm text-slate-400 mb-8">
          <a href="/" class="hover:text-slate-600 no-underline">Home</a>
          <span>/</span>
          <a href="/blog/" class="hover:text-slate-600 no-underline">Blog</a>
          <span>/</span>
          <span class="text-slate-600">{post.title.slice(0, 50)}...</span>
        </nav>
        <article>
          <div class="aspect-[21/9] rounded-2xl overflow-hidden bg-slate-200 mb-8">
            <img src={post.image} alt={post.title} class="w-full h-full object-cover" />
          </div>
          <div class="flex items-center gap-4 text-sm text-slate-400 mb-4">
            <span>{post.author}</span>
            <span>&bull;</span>
            <time datetime={post.date}>{new Date(post.date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
          </div>
          <h1 class="text-3xl md:text-4xl font-bold tracking-tighter text-slate-900 leading-tight">{post.title}</h1>
          <p class="mt-4 text-lg text-slate-500 leading-relaxed">{post.excerpt}</p>
          <div class="flex flex-wrap gap-2 mt-6 mb-10">
            {post.tags.map((tag) => (<span class="text-xs px-3 py-1 rounded-full bg-slate-100 text-slate-500">{tag}</span>))}
          </div>
          <div class="max-w-none">
            {post.content.map((block: any) => {
              if (block.type === "p") return <p class="text-slate-600 leading-relaxed mb-4">{block.text}</p>;
              if (block.type === "h2") return <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mt-10 mb-4">{block.text}</h2>;
              if (block.type === "h3") return <h3 class="text-lg font-semibold text-slate-900 mt-8 mb-3">{block.text}</h3>;
              if (block.type === "ul") return (<ul class="space-y-2 mb-4">{(block.items || []).map((item: string) => (<li class="flex items-start gap-2 text-slate-600"><span class="text-accent mt-1 shrink-0">&bull;</span>{item}</li>))}</ul>);
              return null;
            })}
          </div>
        </article>
        <div class="mt-16 pt-10 border-t border-slate-200">
          <h2 class="text-2xl font-bold tracking-tighter text-slate-900 mb-6">More Articles</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {allPosts.filter((p) => p.slug !== post.slug).map((p) => (
              <a href={`/blog/${p.slug}`} class="block rounded-xl overflow-hidden bg-white border border-slate-200 hover:border-accent hover:shadow-md transition-all no-underline group">
                <div class="aspect-[16/10] overflow-hidden bg-slate-100">
                  <img src={p.image} alt={p.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
                <div class="p-4">
                  <h3 class="font-semibold text-slate-900 text-sm">{p.title}</h3>
                  <p class="text-xs text-slate-500 mt-1.5 line-clamp-2">{p.excerpt}</p>
                  <div class="flex items-center gap-3 mt-3 text-xs text-slate-400">
                    <span>{p.author}</span>
                    <time datetime={p.date}>{p.date}</time>
                  </div>
                </div>
              </a>
            ))}
          </div>
          <div class="mt-6 text-center">
            <a href="/blog/" class="text-sm text-accent hover:underline">&larr; Back to all articles</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.chinese-mountains.com/" },
      { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.chinese-mountains.com/blog" },
      { "@type": "ListItem", "position": 3, "name": post.title }
    ]
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.excerpt,
    "image": post.image,
    "author": { "@type": "Person", "name": post.author },
    "datePublished": post.date,
    "dateModified": post.date
  })} />
</BaseLayout>
