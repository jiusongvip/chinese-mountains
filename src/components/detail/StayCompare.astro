---
import type { StayOption } from "../../types/mountain";

interface Props {
  stays: StayOption[];
}
const { stays } = Astro.props;

const locLabel: Record<StayOption["location"], string> = {
  summit: "Summit",
  base: "Mountain base",
  city: "Nearby city",
};
const locStyle: Record<StayOption["location"], string> = {
  summit: "bg-sky-100 text-sky-700",
  base: "bg-amber-100 text-amber-700",
  city: "bg-slate-100 text-slate-600",
};
---
<section id="stays" class="scroll-mt-36 mt-16">
  <h2 class="text-2xl font-bold tracking-tighter text-slate-900">Where to stay: summit or base?</h2>
  <p class="mt-2 text-slate-500 text-sm max-w-[60ch]">The single biggest decision of the trip is not which route — it is whether you sleep on the mountain. Here is the honest trade-off.</p>

  <div class="grid md:grid-cols-2 gap-4 mt-6">
    {stays.map((s) => (
      <div class="bg-white border border-slate-200 rounded-xl p-5 flex flex-col">
        <div class="flex items-start justify-between gap-2">
          <div>
            <h3 class="font-semibold text-slate-900">{s.name}</h3>
            <div class="flex items-center gap-2 mt-1.5">
              <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${locStyle[s.location]}`}>{locLabel[s.location]}</span>
            </div>
          </div>
        </div>
        <div class="mt-3 space-y-2 text-sm">
          <div class="flex justify-between gap-3"><span class="text-slate-400 text-xs uppercase tracking-wider">Price</span><span class="text-slate-700 font-medium text-right">{s.price}</span></div>
          <div class="flex justify-between gap-3"><span class="text-slate-400 text-xs uppercase tracking-wider">Sunrise access</span><span class="text-slate-700 font-medium text-right">{s.sunriseAccess}</span></div>
        </div>
        <ul class="mt-4 space-y-1.5 text-sm text-slate-600">
          {s.pros.map((p) => <li class="flex items-start gap-1.5"><span class="text-emerald-500 mt-0.5 shrink-0">+</span>{p}</li>)}
          {s.cons.map((c) => <li class="flex items-start gap-1.5"><span class="text-rose-400 mt-0.5 shrink-0">–</span>{c}</li>)}
        </ul>
        <p class="mt-4 pt-3 border-t border-slate-100 text-sm text-slate-600"><span class="font-medium text-slate-800">Best for:</span> {s.bestFor}</p>
      </div>
    ))}
  </div>
</section>
