---
import type { RouteOption } from "../../types/mountain";

interface Props {
  routes: RouteOption[];
}
const { routes } = Astro.props;

const diffLabel: Record<RouteOption["difficulty"], string> = {
  easy: "Easy",
  moderate: "Moderate",
  hard: "Hard",
};
const typeLabel: Record<RouteOption["type"], string> = {
  "cable-car": "Cable car",
  hike: "Hike",
  shuttle: "Shuttle",
};
---
<section id="routes" class="scroll-mt-36 mt-16">
  <h2 class="text-2xl font-bold tracking-tighter text-slate-900">Which route should you take?</h2>
  <p class="mt-2 text-slate-500 text-sm max-w-[60ch]">All the ways up and around, compared side by side so you don't have to open five pages.</p>

  <!-- Desktop table -->
  <div class="hidden md:block mt-6 overflow-x-auto rounded-xl border border-slate-200">
    <table class="w-full text-sm bg-white">
      <thead>
        <tr class="bg-slate-50 text-left text-xs uppercase tracking-wider text-slate-400">
          <th class="px-4 py-3 font-medium">Route</th>
          <th class="px-4 py-3 font-medium">Time</th>
          <th class="px-4 py-3 font-medium">Cost</th>
          <th class="px-4 py-3 font-medium">Difficulty</th>
          <th class="px-4 py-3 font-medium">Scenery</th>
          <th class="px-4 py-3 font-medium">Best for</th>
        </tr>
      </thead>
      <tbody>
        {routes.map((r) => (
          <tr class={`border-t border-slate-100 align-top ${r.recommended ? "bg-accent-50/60" : ""}`}>
            <td class="px-4 py-4">
              <div class="font-semibold text-slate-900 flex items-center gap-2">
                {r.name}
                {r.recommended && (
                  <span class="text-[10px] font-bold uppercase tracking-wider bg-accent text-white px-1.5 py-0.5 rounded">Recommended</span>
                )}
              </div>
              <div class="text-xs text-slate-400 mt-0.5">{r.gate} · {typeLabel[r.type]}</div>
            </td>
            <td class="px-4 py-4 text-slate-600">{r.time}</td>
            <td class="px-4 py-4 text-slate-600">{r.cost}</td>
            <td class="px-4 py-4">
              <span class={`text-xs px-2 py-0.5 rounded-full ${r.difficulty === "easy" ? "bg-emerald-100 text-emerald-700" : r.difficulty === "moderate" ? "bg-amber-100 text-amber-700" : "bg-rose-100 text-rose-700"}`}>{diffLabel[r.difficulty]}</span>
            </td>
            <td class="px-4 py-4 text-slate-600">
              <span class="text-amber-500">{"★".repeat(r.scenery)}<span class="text-slate-300">{"★".repeat(5 - r.scenery)}</span></span>
            </td>
            <td class="px-4 py-4 text-slate-600">{r.bestFor}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <!-- Mobile cards -->
  <div class="md:hidden mt-6 space-y-4">
    {routes.map((r) => (
      <div class={`bg-white border rounded-xl p-5 ${r.recommended ? "border-accent" : "border-slate-200"}`}>
        <div class="flex items-center justify-between gap-2">
          <h3 class="font-semibold text-slate-900 text-sm">{r.name}</h3>
          {r.recommended && <span class="text-[10px] font-bold uppercase tracking-wider bg-accent text-white px-1.5 py-0.5 rounded shrink-0">Recommended</span>}
        </div>
        <p class="text-xs text-slate-400 mt-0.5">{r.gate} · {typeLabel[r.type]}</p>
        <div class="flex flex-wrap gap-2 mt-3 text-xs">
          <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600">{r.time}</span>
          <span class="px-2 py-1 rounded-full bg-slate-100 text-slate-600">{r.cost}</span>
          <span class={`px-2 py-1 rounded-full ${r.difficulty === "easy" ? "bg-emerald-100 text-emerald-700" : r.difficulty === "moderate" ? "bg-amber-100 text-amber-700" : "bg-rose-100 text-rose-700"}`}>{diffLabel[r.difficulty]}</span>
          <span class="px-2 py-1 rounded-full bg-slate-100 text-amber-600">{"★".repeat(r.scenery)}</span>
        </div>
        <ul class="mt-3 space-y-1 text-sm text-slate-500">
          {r.pros.map((p) => <li class="flex items-start gap-1.5"><span class="text-emerald-500 mt-0.5">+</span>{p}</li>)}
          {r.cons.map((c) => <li class="flex items-start gap-1.5"><span class="text-rose-400 mt-0.5">–</span>{c}</li>)}
        </ul>
        <p class="mt-3 text-sm text-slate-600"><span class="font-medium text-slate-800">Best for:</span> {r.bestFor}</p>
      </div>
    ))}
  </div>
</section>
