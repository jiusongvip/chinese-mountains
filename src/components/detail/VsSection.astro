---
import type { Comparison } from "../../types/mountain";
import { getMountain } from "../../data/mountains";

interface Props {
  comparisons: Comparison[];
}
const { comparisons } = Astro.props;
---
<section id="vs" class="scroll-mt-36 mt-16">
  <h2 class="text-2xl font-bold tracking-tighter text-slate-900">How it compares with similar mountains</h2>
  <p class="mt-2 text-slate-500 text-sm max-w-[60ch]">Straight answers to the comparisons travelers actually search for — no need to open five tabs.</p>

  <div class="space-y-4 mt-6">
    {comparisons.map((c) => {
      const other = getMountain(c.slug);
      return (
        <div class="bg-white border border-slate-200 rounded-xl p-6">
          <div class="flex items-start justify-between gap-4">
            <h3 class="text-lg font-bold tracking-tighter text-slate-900">{c.headline}</h3>
            {other && (
              <a href={`/mountains/${other.slug}/`} class="shrink-0 text-xs font-semibold text-accent hover:underline no-underline whitespace-nowrap">
                {other.name.en} details →
              </a>
            )}
          </div>
          <ul class="mt-4 space-y-2">
            {c.differences.map((d) => (
              <li class="flex items-start gap-2 text-sm text-slate-600 leading-relaxed">
                <span class="text-accent mt-1 shrink-0">•</span>
                {d}
              </li>
            ))}
          </ul>
          <p class="mt-4 pt-3 border-t border-slate-100 text-sm text-slate-700 leading-relaxed">
            <span class="font-semibold text-slate-900">Our verdict: </span>{c.verdict}
          </p>
        </div>
      );
    })}
  </div>
</section>
