---
export interface Props {
  name: string;
  zhName: string;
  tagline: string;
  imageSrc: string;
  imageAlt: string;
  elevation: number;
  province: string;
  difficulty: string;
  overall: number;
  slug: string;
}

const { name, zhName, tagline, imageSrc, imageAlt, elevation, province, difficulty, overall, slug } = Astro.props;
const difficultyColor = {
  easy: "bg-emerald-100 text-emerald-700",
  moderate: "bg-amber-100 text-amber-700",
  hard: "bg-orange-100 text-orange-700",
  extreme: "bg-red-100 text-red-700",
}[difficulty] ?? "bg-slate-100 text-slate-600";
---

<a href={`/mountains/${slug}`} class="group block rounded-xl overflow-hidden bg-white border border-slate-200/80 hover:border-slate-300 hover:shadow-lg transition-all duration-300 no-underline">
  <div class="aspect-[4/3] overflow-hidden bg-slate-100">
    <img src={imageSrc} alt={imageAlt} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2 mb-1">
      <div>
        <h3 class="font-semibold text-slate-900 text-base leading-tight">{name}</h3>
        <p class="text-xs text-slate-400 mt-0.5">{zhName} · {province}</p>
      </div>
      <span class="shrink-0 text-sm font-semibold text-accent">{overall}</span>
    </div>
    <p class="text-sm text-slate-500 leading-relaxed mt-2 line-clamp-2">{tagline}</p>
    <div class="flex items-center gap-2 mt-3">
      <span class="text-xs px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">{elevation.toLocaleString()}m</span>
      <span class={`text-xs px-2 py-0.5 rounded-full ${difficultyColor}`}>{difficulty}</span>
    </div>
  </div>
</a>
