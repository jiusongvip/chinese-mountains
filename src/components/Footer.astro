---
const footerLinks = {
   Explore: [
    { href: "/explore", label: "Explore All" },
   { href: "/best", label: "Best Mountains" },
   { href: "/compare", label: "Compare" },
   { href: "/gallery", label: "Photo Gallery" },
  ],
  Guides: [
    { href: "/guides", label: "Travel Guides" },
    { href: "/guides/spring", label: "Spring Peaks" },
    { href: "/guides/summer", label: "Summer Escapes" },
    { href: "/guides/autumn", label: "Autumn Gold" },
    { href: "/guides/winter", label: "Winter Wonder" },
  ],
  Site: [
    { href: "/about", label: "About" },
    { href: "/blog", label: "Blog" },
    { href: "/contact", label: "Contact" },
    { href: "/privacy", label: "Privacy" },
  ],
};
---

<footer class="border-t border-slate-200 bg-slate-50 mt-24">
  <div class="max-w-[1400px] mx-auto px-6 py-16 grid grid-cols-2 md:grid-cols-4 gap-8">
    <div class="col-span-2 md:col-span-1">
      <a href="/" class="flex items-center gap-2 text-slate-900 font-semibold text-lg tracking-tight no-underline mb-3">
        <span class="w-7 h-7 rounded-md bg-accent flex items-center justify-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 22h20L12 2z"/></svg>
        </span>
        Chinese Mountains
      </a>
      <p class="text-sm text-slate-500 max-w-[30ch]">Discover every famous peak in China. Interactive maps, detailed guides, and tools to help you find your perfect mountain.</p>
    </div>
    {Object.entries(footerLinks).map(([title, links]) => (
      <div>
        <h4 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-4">{title}</h4>
        <ul class="space-y-2.5">
          {links.map(link => (
            <li><a href={link.href} class="text-sm text-slate-600 hover:text-slate-900 transition-colors no-underline">{link.label}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="max-w-[1400px] mx-auto px-6 pb-8 flex flex-col sm:flex-row gap-2 justify-between text-xs text-slate-400">
    <span>&copy; {new Date().getFullYear()} Chinese Mountains. All rights reserved.</span>
  </div>
</footer>
